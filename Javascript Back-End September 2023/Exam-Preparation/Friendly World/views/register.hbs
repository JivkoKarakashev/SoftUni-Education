<main class="register">
    <!-- Register Page (Only for Guest users) -->
    <section id="register">
        <div class="form">
            <h2>Register</h2>
            <form class="login-form" method="post" action="/auth/register">
                <input {{#if error.fields.email}}class="field-error"{{/if}} type="text" name="email" id="register-email" placeholder="email" />
                <input {{#if error.fields.password}}class="field-error" {{/if}} type="password" name="password" id="register-password" placeholder="password" />
                <input {{#if error.fields.rePass}}class="field-error" {{/if}} type="password" name="rePass" id="repeat-password" placeholder="repeat password" />
                <button type="submit">Register</button>
                <p class="message">Already registered? <a href="/auth/login">Login</a></p>
            </form>
        </div>
    </section>
</main>