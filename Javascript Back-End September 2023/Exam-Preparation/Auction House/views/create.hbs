<!-- Create Page -->
<section id="create-section" class="">

    <h1 class="item">New Auction</h1>

    <div class="item padded align-center">

        <form class="layout left large" method="POST" action="/create">

            <div class="col aligned">
                <label>
                    <span>Title</span>
                    <input type="text" name="title" value="{{body.title}}">
                </label>
                <label>
                    <span>Category</span>
                    <select name="category">
                        <option value="{{body.selected.value}}" selected>{{body.selected.text}}</option>
                        {{#each body.restoptions}}
                        <option value="{{this.value}}">{{this.text}}</option>
                        {{/each}}
                    </select>
                </label>
                <label>
                    <span>Image URL</span>
                    <input type="text" name="imgurl" value="{{body.imgurl}}"></label>
                <label>
                    <span>Starting price</span>
                    <input type="number" name="price" value="{{body.price}}"></label>
            </div>

            <div class="content pad-med align-center vertical">
                <label>
                    <span>Description</span>
                    <textarea name="description">{{body.description}}</textarea>
                </label>

                <div class="align-center">
                    <input class="action" type="submit" value="Publish Item">
                </div>
            </div>

        </form>

    </div>

</section>