<section id="details-info">
    <h1>Details</h1>
    <div class="coin-image">
        <img src="{{offer.imgurl}}">
    </div>

    <div class="coin-info">
        <div class="coin-text">
            <h1 id="name">{{offer.name}}</h1>
            <h3 id="payment">Payment method: {{offer.paymethod}}</h3>
            <p id="price"><span>Price: ${{offer.price}}</span></p>
            <p id="description">{{offer.description}}</p>
        </div>
        {{#if user}}
        <div class="product-btn">
            <!--Only for registered user and author of the publication -->
            {{#if buy.isOwner}}
            <div class="author">
                <a href="/details/{{offer._id}}/edit" class="btn-edit">Edit</a>
                <a href="/details/{{offer._id}}/delete" class="btn-delete">Delete</a>
            </div>
            {{/if}}

            <!-- Logged in user who has not yet buy this crypto-->
            {{#if buy.canBuy}}
            <a href="/details/{{offer._id}}/buy" class="btn-buy">Buy</a>
            {{/if}}

            <!-- Logged in user who has already buy this crypto-->
            {{#if buy.hasBought}}
            <p class="buy-message">You already bought these crypto coins.</p>
            {{/if}}
        </div>
        {{/if}}
    </div>
</section>