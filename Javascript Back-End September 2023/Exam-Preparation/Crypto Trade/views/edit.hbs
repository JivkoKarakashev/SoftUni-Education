<section id="edit-container">
    <div class="edit-container-info">
        <h1>Edit Announcement</h1>
        <form action="/details/{{offer._id}}/edit" method="POST">
            <label>Name:</label>
            <input type="text" id="name" name="name" value="{{offer.name}}">
            <label>Image:</label>
            <input type="text" id="image" name="imgurl" value="{{offer.imgurl}}">
            <label>Price:</label>
            <input type="number" id="price" name="price" value="{{offer.price}}">
            <label>Description:</label>
            <textarea name="description" id="description">{{offer.description}}</textarea>
            <label>Payment method:</label>
            <select id="payment" name="paymethod">
                <option value="{{offer.selected.value}}">{{offer.selected.text}}</option>
                {{#each offer.restoptions}}
                <option value="{{this.value}}">{{this.text}}</option>
                {{/each}}
            </select>
            <input type="submit" id="btn" value="EDIT"></input>
        </form>
    </div>
</section>