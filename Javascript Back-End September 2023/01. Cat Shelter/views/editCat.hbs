<main>
    <form action="/edit/{{catObj.id}}" method="post" class="cat-form" enctype="multipart/form-data">
        <h2>Edit Cat</h2>
        <label for="name">Name</label>
        <input type="text" id="name" name="name" value="{{catObj.name}}">
        <label for="description">Description</label>
        <textarea id="description" name="description">{{catObj.description}}</textarea>
        <label for="image">Image</label>
        <input type="file" id="image" name="image">
        <label for="group">Breed</label>
        <select id="group" name="breed">
            <option value="{{catObj.breed}}">{{catObj.breed}}</option>
            {{#each breeds}}
            <option value="{{breed}}">{{breed}}</option>
            {{/each}}
        </select>
        <button>Edit Cat</button>
    </form>
</main>