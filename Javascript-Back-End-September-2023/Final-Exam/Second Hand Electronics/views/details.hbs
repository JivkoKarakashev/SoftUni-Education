<section id="detailsPage">
    <div id="detailsInfo">
        <h1>Name: {{offer.name}}</h1>
        <div class="info"><img src="{{offer.imgurl}}"></div>

        <div class="info">
            <h3>Type: {{offer.type}}</h3>
            <h3>Year of Production: {{offer.production}}</h3>
            <h3>Years of Exploitation: {{offer.exploitation}}</h3>
            <h3>Damages: {{offer.damages}}</h3>
            <h3>Description: {{offer.description}}</h3>
            <h2>Price: ${{offer.price}}</h2>
        </div>

        <!--If there is user logged in-->
        {{#if user}}
        <div class="buttons">

            <!--If user is not owner of the toy post-->
            {{#if status.canBuy}}
            <a href="/details/{{offer._id}}/buy" class="buy-btn">Buy</a>
            {{/if}}
            <!--If user is owner-->
            {{#if status.isOwner}}
            <a href="/details/{{offer._id}}/edit" class="edit-btn">Edit</a>
            <a href="/details/{{offer._id}}/delete" class="delete-btn">Delete</a>
            {{/if}}
            <!--If user is not the owner and is bought this toy-->
            {{#if status.hasBought}}
            <p><span class="buy">Thank You For Your Purchase</span></p>
            {{/if}}
        </div>
        {{/if}}
    </div>
</section>