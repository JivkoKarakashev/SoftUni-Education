<section id="edit-page">
    <div class="editSection">
        <div class="info">
            <h2>"I've Always Wanted To Use That Spell."</h2>
        </div>

        <form action="/details/{{creature._id}}/edit" method="POST" class="editForm">
            <h2>Edit Post</h2>
            <ul class="noBullet">
                <li>
                    <label for="name">Name:</label>
                    <input type="text" class="inputFields" id="name" name="name" value="{{creature.name}}" />
                </li>
                <li>
                    <label for="species">Species:</label>
                    <input type="text" class="inputFields" id="species" name="species" value="{{creature.species}}" />
                </li>
                <li>
                    <label for="skin">Skin Colour:</label>
                    <input type="text" class="inputFields" id="skin" name="skincolor" value="{{creature.skincolor}}" />
                </li>
                <li>
                    <label for="eye">Eye Colour:</label>
                    <input type="text" class="inputFields" id="eye" name="eyecolor" value="{{creature.eyecolor}}" />
                </li>
                <li>
                    <label for="image">Creature Image:</label>
                    <input type="text" class="inputFields" id="image" name="imgUrl" value="{{creature.imgUrl}}" />
                </li>
                <li>
                    <label for="description">Description:</label>
                    <textarea id="description" class="inputFields" name="description">{{creature.description}}</textarea>
                </li>
                <li id="center-btn">
                    <button id="edit-btn">Edit</button>
                </li>
            </ul>
        </form>

    </div>
</section>