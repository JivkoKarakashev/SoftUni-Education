<section id="create-container">
    <div class="create-container-info">
        <h1>Create Announcement</h1>
        <h4>Post your coins to sell</h4>
        <form action="/create" method="POST">
            <label>Name:</label>
            <input type="text" id="name" name="name" placeholder="Bitcoin" value="{{body.name}}">
            <label>Image:</label>
            <input type="text" id="image" name="imgurl" placeholder="http://..." value="{{body.imgurl}}">
            <label>Price:</label>
            <input type="number" step="any" id="price" name="price" placeholder="31,166.71" value="{{body.price}}">
            <label>Description:</label>
            <textarea id="description" name="description" placeholder="Introduce your coins...">{{body.description}}</textarea>
            <label>Payment method:</label>
            <select id="payment" name="paymethod">
                <option value="{{body.selected.value}}">{{body.selected.text}}</option>
                {{#each body.restoptions}}
                <option value="{{this.value}}">{{this.text}}</option>
                {{/each}}
            </select>
            <input type="submit" id="btn" value="TRADE"></input>
        </form>
    </div>
</section>