<li class="item">
    <header class="pad-med">
        <h2>{{title}}</h2>
    </header>

    <div class="align-center">

        <img class="img-thumb" src="{{imgurl}}">

    </div>

    <footer class="align-center pad-med">
        <p>Closing price: <strong>${{price}}</strong></p>
        from {{bidder.firstname}} {{bidder.lastname}}
    </footer>
</li>