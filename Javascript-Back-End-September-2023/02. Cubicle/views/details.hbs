<h1>{{cubeObj.name}}</h1>
<img class="cube" src="{{cubeObj.imageUrl}}">
<div class="details">
    <p><span>Description:</span>{{cubeObj.description}}</p>
    <p><span>Difficulty level:</span> {{cubeObj.difficultyLevel}}</p>
    <a class="btn" href="/">Back</a>
    {{#if hasUser}}
    <a class="btn" href="/attach/accessory/{{cubeObj._id}}">Attach Accessory</a>
    {{/if}}
    {{#if isOwner}}
    <a class="btn" href="/details/{{cubeObj._id}}/edit">Edit</a>
    <a class="btn" href="/details/{{cubeObj._id}}/delete">Delete</a>
    {{/if}}
</div>
<h2>Accessories</h2>
<div class="accessories">
    {{#if accessories}}
    {{#each accessories}}
    <div class="accessory">
        <img src="{{imageUrl}}" alt="stickerName">
        <h3>{{name}}</h3>
        <p>{{description}}</p>
    </div>
    {{/each}}
    {{else}}
    <h3 class="italic">This cube has no accessories yet...</h3>
    {{/if}}
</div>